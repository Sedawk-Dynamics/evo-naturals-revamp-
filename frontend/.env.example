# Copy to .env.local and supply your SMTP provider settings. Never use NEXT_PUBLIC_ here.
# URL-encode special characters in the username and password.
SMTP_URL=smtps://USERNAME:PASSWORD@smtp.example.com:465
# Use a sender address verified with your SMTP provider.
SMTP_FROM="Evo Naturals <sales@example.com>"
# Inbox that receives customer enquiries.
SALES_EMAIL=sales@example.com
